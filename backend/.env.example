# --- Blog (GCS) ---
GCS_BLOG_BUCKET=ivmanto-com-prod-514215-blog

# --- Google Analytics ---
GA_MEASUREMENT_ID=G-W1TJ3KMZ6V
GA_API_SECRET=REPLACE_WITH_GA_API_SECRET

# --- Optional ---
# ARTICLES_STATUS_TOKEN= (shared secret for the operator status endpoint, Authorization header)
