{
  "$description": "ivmanto typography, spacing, radius, shadow and motion tokens. Base unit 4px. Mirrored in foundation.css.",
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "Inter",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "sans-serif"
        ],
        "$description": "UI and body. Self-hosted (no Google Fonts CDN, GDPR)."
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "JetBrains Mono",
          "ui-monospace",
          "monospace"
        ],
        "$description": "Framework IDs (ISO/IEC 42001), code, figures in tables."
      },
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Montserrat",
          "Inter",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Headlines (h1-h3, prices). Montserrat, approved by Nick 2026-11-10. SIL OFL, has Cyrillic incl. Bulgarian forms. Self-hosted. (The logo is outlined artwork in Instrument Sans; no font needed for it.)"
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      }
    },
    "size": {
      "xs": {
        "$type": "dimension",
        "$value": "0.75rem",
        "$description": "12px: legal, overline"
      },
      "sm": {
        "$type": "dimension",
        "$value": "0.875rem",
        "$description": "14px: captions, meta"
      },
      "md": {
        "$type": "dimension",
        "$value": "1rem",
        "$description": "16px: UI text"
      },
      "lg": {
        "$type": "dimension",
        "$value": "1.125rem",
        "$description": "18px: body copy on marketing pages"
      },
      "xl": {
        "$type": "dimension",
        "$value": "1.25rem",
        "$description": "20px: lead paragraph, h4"
      },
      "2xl": {
        "$type": "dimension",
        "$value": "1.5rem",
        "$description": "24px: h3"
      },
      "3xl": {
        "$type": "dimension",
        "$value": "2rem",
        "$description": "32px: h2"
      },
      "4xl": {
        "$type": "dimension",
        "$value": "2.5rem",
        "$description": "40px: h1 mobile"
      },
      "5xl": {
        "$type": "dimension",
        "$value": "3.25rem",
        "$description": "52px: h1 desktop (hero)"
      }
    },
    "lineHeight": {
      "tight": {
        "$type": "number",
        "$value": 1.15,
        "$description": "Headlines"
      },
      "snug": {
        "$type": "number",
        "$value": 1.35,
        "$description": "Sub-headlines, cards"
      },
      "body": {
        "$type": "number",
        "$value": 1.65,
        "$description": "Paragraphs"
      }
    },
    "tracking": {
      "headline": {
        "$type": "dimension",
        "$value": "-0.015em"
      },
      "overline": {
        "$type": "dimension",
        "$value": "0.12em",
        "$description": "Uppercase overlines and the wordmark"
      }
    },
    "measure": {
      "$type": "dimension",
      "$value": "68ch",
      "$description": "Max line length for body copy"
    }
  },
  "space": {
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "6": {
      "$type": "dimension",
      "$value": "24px"
    },
    "8": {
      "$type": "dimension",
      "$value": "32px"
    },
    "12": {
      "$type": "dimension",
      "$value": "48px"
    },
    "16": {
      "$type": "dimension",
      "$value": "64px"
    },
    "24": {
      "$type": "dimension",
      "$value": "96px",
      "$description": "Section spacing desktop"
    },
    "32": {
      "$type": "dimension",
      "$value": "128px"
    }
  },
  "layout": {
    "container": {
      "$type": "dimension",
      "$value": "1200px"
    },
    "gutter-mobile": {
      "$type": "dimension",
      "$value": "20px"
    },
    "gutter-desktop": {
      "$type": "dimension",
      "$value": "32px"
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "Badges, tags"
    },
    "md": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Buttons, inputs"
    },
    "lg": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Cards"
    },
    "full": {
      "$type": "dimension",
      "$value": "9999px",
      "$description": "Avatars only"
    }
  },
  "shadow": {
    "sm": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px",
        "color": "#0f172a14"
      }
    },
    "md": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0px",
        "offsetY": "4px",
        "blur": "16px",
        "spread": "-4px",
        "color": "#0f172a1f"
      },
      "$description": "Card hover only. Dark theme uses border instead of shadow."
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "150ms"
      },
      "base": {
        "$type": "duration",
        "$value": "250ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "400ms",
        "$description": "Section reveal, max"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      }
    },
    "$description": "No infinite animations, no float/blob/glow. One approved exception: the home hero (components/hero-motion.md). Respect prefers-reduced-motion: disable all transforms."
  }
}
